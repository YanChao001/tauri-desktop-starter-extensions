{
  "formatVersion": 3,
  "apiVersion": 2,
  "minHostVersion": "0.1.8",
  "id": "market.wallpaper-browser",
  "version": "1.2.5",
  "name": "壁纸库",
  "author": "Tauri Desktop Starter",
  "description": "浏览在线壁纸，管理本机图库并设置应用背景。",
  "icon": "image",
  "commands": [
    {
      "id": "browse",
      "title": "壁纸库",
      "function": "browse",
      "inputFormat": "json",
      "resultFormat": "view",
      "ui": {
        "sidebar": true,
        "window": true,
        "document": "main"
      },
      "permissions": ["wallpapers:manage"]
    }
  ],
  "permissions": ["wallpapers:manage"],
  "optionalPermissions": [
    "network:https",
    "network:images",
    "links:open",
    "network:system-proxy"
  ],
  "network": [
    {
      "origin": "https://wp.upx8.com",
      "methods": ["GET"]
    },
    {
      "origin": "https://wallhaven.cc",
      "methods": ["GET"]
    },
    {
      "origin": "https://commons.wikimedia.org",
      "methods": ["GET"]
    },
    {
      "origin": "https://nekos.best",
      "methods": ["GET"]
    }
  ]
}
