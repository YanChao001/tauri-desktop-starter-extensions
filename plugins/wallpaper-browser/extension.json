{
  "formatVersion": 3,
  "apiVersion": 2,
  "minHostVersion": "0.1.6",
  "id": "market.wallpaper-browser",
  "version": "1.0.3",
  "name": "壁纸库",
  "author": "Tauri Desktop Starter",
  "description": "按关键词搜索必应图片，预览与保存原图，管理本机图库和应用背景。不按许可筛选；搜索、远程图片、来源外链与系统代理分别可选授权，拒绝联网仍可使用本机图库。不改变操作系统桌面壁纸。",
  "icon": "image",
  "commands": [
    {
      "id": "browse",
      "title": "壁纸库",
      "function": "browse",
      "inputFormat": "json",
      "resultFormat": "view",
      "ui": {
        "sidebar": true,
        "window": true,
        "document": "main"
      },
      "permissions": ["wallpapers:manage"]
    }
  ],
  "permissions": ["wallpapers:manage"],
  "optionalPermissions": [
    "network:https",
    "network:images",
    "links:open",
    "network:system-proxy"
  ],
  "network": [{ "origin": "https://cn.bing.com", "methods": ["GET"] }]
}
